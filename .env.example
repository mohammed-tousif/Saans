# Saans — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# Required: Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name (configurable; check account availability)
GEMINI_MODEL=gemini-2.5-flash

# Server configuration
HOST=0.0.0.0
PORT=8000

# Data provider settings
# Open-Meteo does not require an API key for non-commercial use
OPEN_METEO_TIMEOUT_SECONDS=10

# Provider mode: "live" or "fixture"
DATA_MODE=live

# Rate limiting
MAX_PLAN_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_GEMINI_CALLS=2

# Optional: Google Air Quality API (not required for MVP)
# GOOGLE_AQ_API_KEY=your-google-aq-key-here
